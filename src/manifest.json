{
  "manifest_version": 3,
  "name": "o11keys",
  "version": "2.3.4",
  "version_name": "2.3.4",
  "description": "A refined playback systems control center.",
  "author": "o11dev",
  "homepage_url": "https://github.com/drmforall/o11keys",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "tabs",
    "scripting",
    "storage",
    "notifications",
    "unlimitedStorage",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "pages/panel/panel.html",
    "default_icon": {
      "128": "images/icon.png"
    }
  },
  "icons": {
    "128": "images/icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file://*/*"],
      "js": ["message_proxy.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "o11keys@extensions.local",
      "strict_min_version": "140.0"
    }
  }
}
