        "@xmldom/xmldom": "^0.9.12",
        "node-forge": "^1.4.2",
        "protobufjs": "^8.8.1"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.2",
        "archiver": "^7.0.1",
        "protobufjs-cli": "^2.7.1",
        "rollup": "^2.79.2",
        "rollup-plugin-terser": "^7.0.2",
        "sharp": "^0.35.5"
    },
    "type": "module"
