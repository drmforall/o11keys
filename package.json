{
    "name": "o11keys",
    "version": "2.3.4",
    "description": "o11keys browser playback control center",
    "main": "build.js",
    "scripts": {
        "build": "npm run icons && npx rollup -c && node build.js",
        "icons": "node artwork/generate-icons.mjs",
        "test": "node --test tests/*.test.mjs"
    },
    "keywords": [
        "chrome-extension",
        "firefox-addon",
        "drm",
        "widevine",
        "playready",
